# LKFL — Dev Server Environment (serverAi: 192.168.1.27)
# ADR-043: Два стенда — dev (ручной деплой) + staging (CI/CD)
#
# Стенд: https://project.ukituki.tech
# Деплой: infra/deploy/dev-deploy.sh <IMAGE_TAG>
# Директория: /home/ukituki/LKFL-dev/
#
# Скопировать в .env.dev-server, заполнить секреты
# Никогда не коммитить .env.dev-server!

# =========================================================================
# Database — PostgreSQL 17 (порт 15434)
# =========================================================================
POSTGRES_USER=lkfl
POSTGRES_PASSWORD=lkfl-dev-password
DB_DSN=postgresql://lkfl:lkfl-dev-password@postgres:5432/lkfl_platform_dev?sslmode=disable

# =========================================================================
# Redis (порт 16380)
# =========================================================================
REDIS_URL=redis://redis:6379

# =========================================================================
# Keycloak (порт 19083)
# =========================================================================
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_ISSUER=https://project.ukituki.tech/realms/lkfl-sdek
KEYCLOAK_PUBLIC_URL=https://project.ukituki.tech/realms/lkfl-sdek
KEYCLOAK_CLIENT_ID=lkfl-spa
KEYCLOAK_CLIENT_SECRET=changeme-dev

# =========================================================================
# Server (порт 18082)
# =========================================================================
SERVER_PORT=8080
LOG_LEVEL=debug
SENTRY_DSN=
JWT_SECRET=changeme-dev
RATE_LIMIT_AUTH=100
RATE_LIMIT_CATALOG=500
RATE_LIMIT_ADMIN=200

# =========================================================================
# GHCR — registry
# =========================================================================
GHCR_REGISTRY=ghcr.io/ukituki-ps/lkfl
IMAGE_TAG=main-latest
GHCR_USERNAME=ukituki

# =========================================================================
# Grafana (порт 13002)
# =========================================================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# =========================================================================
# E2E тесты (для playwright integration)
# =========================================================================
E2E_USERNAME=admin
E2E_PASSWORD=dev-password

# =========================================================================
# Timezone
# =========================================================================
TZ=Europe/Moscow
